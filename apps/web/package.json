{
  "name": "@twinzy/web",
  "version": "0.1.0",
  "private": true,
  "description": "Twinzy frontend (Next.js App Router, mobile-first PWA).",
  "overrides": {
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.3"
    }
  },
  "scripts": {
    "cache:clear": "node scripts/clear-next-cache.mjs",
    "predev": "npm run cache:clear",
    "dev": "next dev --turbopack --port 3000",
    "predev:turbo": "npm run cache:clear",
    "dev:turbo": "next dev --port 3000",
    "predev:e2e": "npm run cache:clear",
    "dev:e2e": "next dev --turbopack",
    "build": "npm --prefix ../.. run build:shared && next build --turbopack",
    "build:turbo": "npm --prefix ../.. run build:shared && next build --turbopack",
    "prestart": "npm run cache:clear",
    "start": "next start --port 3000",
    "typecheck": "node ../../node_modules/tsc7/bin/tsc --noEmit -p tsconfig.json && node ../../node_modules/tsc7/bin/tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "playwright test --project=chromium --project=a11y --project=mobile-chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:webkit": "playwright test --project=mobile-webkit",
    "test:e2e:ci": "playwright test --project=chromium --project=a11y --project=mobile-chromium",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@twinzy/shared": "*",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
